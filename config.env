# 页面标题和浏览器标题显示的应用名称
APP_NAME=TabHub
# 应用在本机或容器内监听的端口
PORT=8080
# Docker 部署时映射到宿主机的访问端口
HOST_PORT=5305

# 管理员登录用户名；程序启动时会同步数据库为这个用户
ADMIN_USERNAME=admin
# 管理员登录密码；程序启动时会同步数据库密码
ADMIN_PASSWORD=admin

# 登录会话签名密钥；部署时请改成足够长的随机字符串
SESSION_SECRET=change-this-session-secret
# 登录保持天数；小于 1 时程序会自动使用 60 天
SESSION_DAYS=60

# SQLite 数据库文件路径
DB_PATH=./data/app.db
# 上传文件和运行数据保存目录
DATA_DIR=./data
# 程序使用的默认时区
TZ=Asia/Shanghai
# 初始化时使用的默认搜索引擎 URL 模板，必须包含 %s
DEFAULT_SEARCH_ENGINE=https://www.baidu.com/s?wd=%s
